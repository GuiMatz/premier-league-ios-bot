# Copie para .env e preencha. Nunca versione o .env.

# --- Discord (obrigatórios) ---
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# ID do usuário que pode usar os comandos administrativos (!admin, !testerodada...)
ADMIN_DISCORD_ID=

# --- Publicação do estado público para o site (opcional) ---
# Sem GITHUB_TOKEN o arquivo state_public.json é gerado só localmente.
GITHUB_TOKEN=
GITHUB_REPO=usuario/premier-league-ios-site
GITHUB_BRANCH=main
GITHUB_STATE_PATH=data/state_public.json
PUBLIC_STATE_FILE=state_public.json

# --- Arquivos e pastas locais (opcional) ---
STATE_FILE=state.json
# Onde o SQLite, os CSVs e o JSON de estatísticas são gravados (padrão: ./estatisticas)
ESTATISTICAS_LIGA_DIR=

# --- Comportamento (opcional) ---
LEAGUE_ENV=development
LEAGUE_WRITER=bot
# resumo | silencioso | individual — gols perdidos enquanto o bot estava offline
CATCHUP_AO_VIVO=resumo
# Slug da liga no Cartola (usado só por funções de consulta da liga)
CARTOLA_LEAGUE_SLUG=
# Chave do TheSportsDB para fotos dos jogadores (vazio = chave pública de teste)
THESPORTSDB_API_KEY=
# 1 = permite rodar com os dados FICTÍCIOS de liga_dados.py (só para testes)
PERMITIR_DADOS_EXEMPLO=

# --- Leitura futura de um backend (experimental, não usado pelo bot.py) ---
BOT_DATA_SOURCE=legacy
LEAGUE_API_BASE_URL=
LEAGUE_API_TIMEOUT=8
